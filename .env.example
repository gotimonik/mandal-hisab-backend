# ---- Database (server-only; never expose to the browser or mobile binary) ----
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/mandalhisab?retryWrites=true&w=majority
MONGODB_DB=mandalhisab

# ---- Auth ----
# Random 32+ byte secret, e.g. `openssl rand -base64 48`. Used to sign email/reset tokens' HMAC.
AUTH_SECRET=replace_with_a_secure_random_secret
SESSION_TTL_DAYS=30
# true = users must verify email before logging in
REQUIRE_EMAIL_VERIFICATION=false

# ---- URLs / CORS ----
APP_URL=http://localhost:4000
# Frontend origin(s) allowed to call this API from a browser / Capacitor webview (comma separated)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,capacitor://localhost,https://localhost

# ---- Organization registration policy: open | approval | disabled ----
ORG_REGISTRATION_POLICY=approval

# ---- Initial platform admin (used only by `npm run seed:admin`) ----
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_PASSWORD=

# ---- Scheduled jobs (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`) ----
CRON_SECRET=replace_with_a_random_cron_secret

# ---- Email (optional). Without RESEND_API_KEY emails are logged, not sent. ----
EMAIL_FROM="MandalHisab <no-reply@example.com>"
RESEND_API_KEY=

# ---- Attachments storage (optional). Vercel Blob read/write token. ----
BLOB_READ_WRITE_TOKEN=
MAX_UPLOAD_BYTES=5242880
